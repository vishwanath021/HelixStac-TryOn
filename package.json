{
  "name": "lookuvi",
  "version": "0.1.0",
  "private": true,
  "description": "Lookuvi — white-label virtual hairstyle and hair-colour try-on for salons.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:push": "node scripts/prepare-prisma.mjs && prisma db push",
    "db:generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "admin:create": "node scripts/create-super-admin.mjs",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts",
    "placeholders": "tsx scripts/generate-placeholders.ts",
    "brows:cards": "tsx scripts/generate-brow-cards.ts",
    "ai:smoke": "node --env-file=.env --import tsx scripts/ai-smoke.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "replay:raw": "tsx scripts/replay-raw.ts",
    "replay:composite": "tsx scripts/replay-composite.ts",
    "benchmark:quote": "tsx scripts/benchmark-quote.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.899.0",
    "@aws-sdk/s3-request-presigner": "^3.899.0",
    "@google/genai": "1.21.0",
    "@mediapipe/tasks-vision": "0.10.21",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "bcryptjs": "2.4.3",
    "clsx": "^2.1.1",
    "lucide-react": "0.544.0",
    "next": "15.5.27",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.1.0",
    "prisma": "6.19.3",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.64.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.18.6",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "fast-xml-parser": "5.11.2",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "deepmerge-ts": "8.0.2"
  }
}
