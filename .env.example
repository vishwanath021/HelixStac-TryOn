# HelixStac TryOn — copy to .env. Never commit real secrets.

# sqlite (one-command local dev) or postgresql://user:pass@localhost:5432/helix
# SQLite path is relative to prisma/schema.prisma, so this file is prisma/dev.db
DATABASE_URL="file:./dev.db"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Public brand (white-label platform name, not a salon)
BRAND_NAME="HelixStac TryOn"
BRAND_LEGAL_NAME="HelixStac"
SUPPORT_EMAIL="privacy@helixstac.example"
APP_BASE_URL="http://localhost:3000"
ROOT_DOMAIN="localhost"

# AI. mock needs no keys and is the default.
# Put real keys only in this file (gitignored) or the host secret store. Never commit them.
AI_PROVIDER="mock"
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# Tiers. A new key and every calibration run use TEST. Guests stay on TEST until promoted.
# Output size is 1024x1024 (smallest size the image edit API accepts). TEST also downscales the input to 768px on the long side.
# Prices below are list prices checked 3 Oct 2026, then ₹96/USD × 1.08, rounded up to ₹0.1. They are estimates, not invoices.
# OpenAI TEST: gpt-image-1-mini, quality low, 1024x1024, about ₹0.60 ($0.005).
OPENAI_IMAGE_MODEL_TEST="gpt-image-1-mini"
# OpenAI MEDIUM: gpt-image-1-mini, quality medium, about ₹1.20 ($0.011).
# Set this to gpt-image-1 to use that model at quality medium (about ₹4.40, $0.042).
OPENAI_IMAGE_MODEL_MEDIUM="gpt-image-1-mini"
# OpenAI HIGH: gpt-image-1, quality high, about ₹17.40 ($0.167). Off until a super-admin enables it.
OPENAI_IMAGE_MODEL_HIGH="gpt-image-1"
# Leave false. The guest photo is the only input image. true also sends public/styles/{id}.jpg.
OPENAI_SEND_STYLE_REFERENCE="false"
GEMINI_SEND_STYLE_REFERENCE="false"
# A key can also be pasted on /super/ai. It is encrypted with AUTH_SECRET and is not returned to the browser.
# Paid-tier only. Free-tier content may be used by Google to improve products.
# Gemini TEST: flash-lite image, about ₹3.50 ($0.0336 per 1K image). MEDIUM and HIGH use flash image, about ₹7.00 ($0.067 per 1K).
GEMINI_MODEL_STANDARD="gemini-3.1-flash-lite-image"
GEMINI_MODEL_MEDIUM="gemini-3.1-flash-image"
GEMINI_MODEL_HD="gemini-3.1-flash-image"
GEMINI_TEXT_MODEL="gemini-3.1-flash-lite"
# Optional failover. Leave blank to keep the stub inactive.
# REPLICATE_API_TOKEN=""
# REPLICATE_MODEL="flux-kontext-apps/change-haircut"
# Optional fallback only. Reference comparisons use the encrypted fal key saved on /super/ai.
# FAL_KEY=""
# Super-admin fal comparisons poll one queue request for this many milliseconds. Default 3600000 (1 hour).
# FAL_TIMEOUT_MS="3600000"
# Optional fallback only. Reference comparisons use the encrypted OpenRouter key saved on /super/ai.
# OpenRouter does not proxy fal.ai models.
# OPENROUTER_API_KEY=""
# FAL_MODEL="fal-ai/flux-pro/kontext"
# Set to gemini to allow the concierge to call a text model. Default is rules.
CONCIERGE_LLM="rules"
MOCK_DELAY_MS="900"

# Billing. mock grants plans and packs instantly.
BILLING_PROVIDER="mock"
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""

# INR per USD for the cost ledger. Tier estimates also multiply by 1.08 and round up to ₹0.1.
FX_INR_PER_USD="96"
# Older labels still read by the super-admin salon table. Guest try-ons use the tier estimates instead.
AI_COST_INR_STANDARD="3.5"
AI_COST_INR_HD="7"

# Caps
DAILY_PROVIDER_SPEND_CAP_USD="25"
# Hard testing guard for paid image calls, in INR estimates (not a provider invoice).
# Default ₹500. At the cap the app returns a labelled sample instead of calling the provider.
AI_SPEND_CAP_INR="500"
# Reference benchmark. Super-admin only, off for guests. One OpenAI edit, no retry.
# Full estimate includes image-input tokens. gpt-image-1.5 quality medium is about ₹12 at 1024 square
# and about ₹17 at 1536×1024 or 1024×1536 (buffered, with a margin over the first paid run). Not an invoice.
# The ₹30 run cap is checked against that full estimate.
BENCHMARK_MODEL="gpt-image-1.5"
BENCHMARK_QUALITY="medium"
BENCHMARK_RUN_CAP_INR="30"
# Leave unset for the full canvas (may be 1536 wide). Set to 1024 to send a smaller selfie and compare cost.
# Wide photos then sit in a square with side bars. The reference stays at its native 512.
# BENCHMARK_INPUT_SIZE="1024"
# Hours to keep benchmark selfies under var/benchmarks. Super-admin only. Not public.
BENCHMARK_RETENTION_HOURS="72"
# Salon try-on reference switch. Leave unset. A signed-in super-admin can turn on
# "Reference mode (test)" on /s/demo-salon. Set to on only on a private machine if an
# explicit referenceMode=yes request should be honored without that session. Guests never
# see the switch. It does not change requests that do not ask for it.
# TRYON_REFERENCE_MODE="on"
# Hair-only composite is a second super-admin switch. It needs Python 3 and mediapipe==0.10.21
# (pip install -r scripts/requirements-vision.txt) plus assets/vision. It does not call a provider.
# VISION_PYTHON="python3"
# How long a repeated guest request id can replay its stored JPEG. Photos stay under var/.
GENERATION_JOB_TTL_HOURS="24"
# When true or 1, write the provider JPEG (after square restore, before the face composite) under var/ai-debug/.
# Local diagnosis only. That folder is not served to guests or salon staff.
DEBUG_SAVE_RAW="false"
# Optional overrides. Leave unset to use the model-id estimates (OpenAI test ₹0.6, medium ₹1.2, high ₹17.4; Gemini test ₹3.5, medium ₹7, high ₹7).
# AI_COST_PER_CALL_INR_OPENAI_TEST="0.6"
# AI_COST_PER_CALL_INR_OPENAI_MEDIUM="1.2"
# AI_COST_PER_CALL_INR_OPENAI_HIGH="17.4"
# AI_COST_PER_CALL_INR_GEMINI_TEST="3.5"
# AI_COST_PER_CALL_INR_GEMINI_MEDIUM="7"
# AI_COST_PER_CALL_INR_GEMINI_HIGH="7"
GENERATE_PER_IP_HOUR="6"
GENERATE_PER_IP_DAY="20"
GENERATE_PER_TENANT_MINUTE="30"

# Optional SMTP for magic links. Without it, development shows the link on screen.
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="HelixStac <login@helixstac.example>"

# Set true only in local dev if you want magic-link URLs returned in the API response.
ALLOW_DEV_MAGIC_LINK="true"

# Guest booking OTP. mock prints a code (and returns it outside production).
# msg91 and twilio are stubs until a sender is implemented.
OTP_PROVIDER="mock"
# ALLOW_DEV_OTP="true"
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""
