+      styleId: "beach-waves",
+      styleName: "Beach Waves",
+      asked: "wavy",
+      files: ["beach-waves.jpg"],
+    });
+    expect(wavy.mismatch).toBe(false);
+    expect(wavy.fileName).toBe("beach-waves.jpg");
+  });
