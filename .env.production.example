# Lookuvi production environment.
# Copy to /opt/lookuvi/.env.production on the droplet and fill in real values.
# Never commit the filled-in file. Lines starting with # are comments.

# --- Required before the process will serve traffic ---

# production. The container also sets this.
NODE_ENV=production

# App traffic uses this URL. If you use a pooler, put the pooler here and the direct URL in DIRECT_URL.
DATABASE_URL=postgresql://helix:CHANGE_ME@db:5432/helix
# Direct URL for prisma migrate deploy. Same as DATABASE_URL when you are not using a pooler.
DIRECT_URL=postgresql://helix:CHANGE_ME@db:5432/helix

# openssl rand -base64 32. At least 16 characters. Do not rotate after AI keys are saved unless AI_KEY_SALT is set and stays put.
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=https://lookuvi.example
AUTH_TRUST_HOST=true

# Public https origin, no trailing slash. Must start with https://
APP_BASE_URL=https://lookuvi.example
# Hostname Caddy serves for the marketing/login site. Usually the host of APP_BASE_URL.
APP_DOMAIN=lookuvi.example
# Apex used for salon hosts: https://<slug>.try.<ROOT_DOMAIN>
ROOT_DOMAIN=lookuvi.example

# Must be true behind Caddy. Caddy overwrites X-Forwarded-For.
TRUST_PROXY=true
# How many proxies append an address. 1 is Caddy alone.
TRUSTED_PROXY_HOPS=1

# Platform and per-salon provider budgets, in INR estimates (not an invoice).
# Each cap sums the current calendar month in Asia/Kolkata and resets on the 1st at 00:00 IST.
AI_SPEND_CAP_INR=5000
AI_SALON_SPEND_CAP_INR=2000

# openssl rand -base64 32. Bearer token for POST /api/cron/retention.
CRON_SECRET=replace-with-another-long-random-string

# local keeps files on the droplet disk (var/objects). s3 uses R2 or S3. Use s3 for a real deploy.
OBJECT_STORAGE=s3
S3_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=lookuvi-previews
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for Cloudflare R2.
S3_FORCE_PATH_STYLE=true

# Leave these false. The container refuses SEED_DEMO.
ALLOW_DEV_MAGIC_LINK=false
ALLOW_DEV_OTP=false
SEED_DEMO=false

# --- Compose-only (not read by the Next process) ---

# Postgres and Redis passwords. DATABASE_URL and REDIS_URL must use the same passwords.
POSTGRES_USER=helix
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=helix
REDIS_PASSWORD=CHANGE_ME
# Set by the deploy script. Example: ghcr.io/vishwanath021/lookuvi:<git sha>
LOOKUVI_IMAGE=

# --- Recommended ---

# redis://:PASSWORD@redis:6379  Required when more than one app container runs.
REDIS_URL=redis://:CHANGE_ME@redis:6379
# database forces the Postgres rate-limit table even outside production. Leave unset in production.
# RATE_LIMIT_STORE=

BRAND_NAME=Lookuvi
BRAND_LEGAL_NAME=Lookuvi
SUPPORT_EMAIL=privacy@lookuvi.example

# Email. Set RESEND_API_KEY or SMTP_URL. EMAIL_FROM must be a sender the provider accepts.
# Without either, forgot-password and magic-link say email is not configured.
RESEND_API_KEY=
# SMTP_URL=smtp://user:pass@smtp.example.com:587
EMAIL_FROM="Lookuvi <login@lookuvi.example>"

# Phone login stays off until all three are set. The MSG91 template must contain ##OTP##.
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Queue alerts. Leave the WhatsApp values blank to log alerts instead of sending them.
# WhatsApp Cloud API runs when WHATSAPP_TOKEN and WHATSAPP_PHONE_ID are both set.
# A failed WhatsApp send is logged. Queue alerts do not send SMS.
# Template parameters: JOIN token, link. ALERT salon, token, minutes, link.
# CONFIRMED salon, date, time, link.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_JOIN=
WHATSAPP_TEMPLATE_ALERT=
WHATSAPP_TEMPLATE_CONFIRMED=
QUEUE_RETENTION_DAYS=30

# First operator. Used only by: node scripts/create-super-admin.mjs
# Password at least 12 characters, not a demo password. Then enroll an authenticator at /super/security.
SUPER_ADMIN_EMAIL=you@lookuvi.example
SUPER_ADMIN_PASSWORD=

# Stable salt for AI key encryption. Set once before the first key is saved on /super/ai.
AI_KEY_SALT=replace-with-a-random-string-you-will-not-rotate

# mock until you save a provider key on /super/ai. Do not put a live key here unless you want it as a fallback.
AI_PROVIDER=mock
BILLING_PROVIDER=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Optional error reporting. Leave empty to skip.
SENTRY_DSN=

# Guest tools. all is the five tools. hairstyle hides the rest.
ENABLED_TOOLS=all

# INR per USD for the cost ledger.
FX_INR_PER_USD=96
AI_COST_INR_STANDARD=3.5
AI_COST_INR_HD=7

# Hours to keep generated previews and benchmark files.
GENERATION_JOB_TTL_HOURS=24
BENCHMARK_RETENTION_HOURS=72

# Guest and staff preview limits.
GENERATE_PER_IP_HOUR=6
GENERATE_PER_IP_DAY=20
GENERATE_PER_TENANT_MINUTE=30
GENERATE_STAFF_PER_IP_HOUR=240
GENERATE_STAFF_PER_IP_DAY=1000
GENERATE_STAFF_PER_MINUTE=120
LOGIN_LIMIT=8
LOGIN_IP_LIMIT=30

# --- Optional provider and model overrides. Leave commented unless you mean to change them. ---

# GEMINI_API_KEY=
# OPENAI_API_KEY=
# REPLICATE_API_TOKEN=
# REPLICATE_MODEL=flux-kontext-apps/change-haircut
