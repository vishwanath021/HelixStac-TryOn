# GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# CONCIERGE_LLM=rules
# SUGGEST_MODEL=
# AI_COST_PER_CALL_INR_OPENAI_TEST=
# AI_COST_PER_CALL_INR_OPENAI_MEDIUM=
# AI_COST_PER_CALL_INR_OPENAI_HIGH=
# AI_COST_PER_CALL_INR_GEMINI_TEST=
# AI_COST_PER_CALL_INR_GEMINI_MEDIUM=
# AI_COST_PER_CALL_INR_GEMINI_HIGH=
# DAILY_PROVIDER_SPEND_CAP_USD=25
# BENCHMARK_MODEL=gpt-image-1.5
# BENCHMARK_QUALITY=medium
# BENCHMARK_RUN_CAP_INR=30
# BENCHMARK_INPUT_SIZE=
# TRYON_REFERENCE_MODE=
# DEBUG_SAVE_RAW=false
# MOCK_DELAY_MS=0
# VISION_PYTHON=python3
# VISION_ASSET_DIR=
# Twilio is not wired. Do not set these expecting texts to send.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
