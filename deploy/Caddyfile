# On-demand certificates for salon hostnames. A true wildcard (*.try.example)
# needs DNS-01 and a custom Caddy build. This file uses HTTP-01: one certificate
# per hostname, and only after GET /api/caddy/ask returns 200.
{
	on_demand_tls {
		ask http://app:3000/api/caddy/ask
		interval 2m
		burst 5
	}
}

{$APP_DOMAIN}, www.{$APP_DOMAIN} {
	reverse_proxy app:3000
}

*.try.{$ROOT_DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy app:3000
}

# Verified custom domains. The ask endpoint refuses any host that is not on file.
https:// {
	tls {
		on_demand
	}
	reverse_proxy app:3000
}
